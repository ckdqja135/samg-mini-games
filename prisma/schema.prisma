generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  nickname    String
  birthDate   DateTime?
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores      Score[]
  challenges  DailyChallenge[]
  attendances Attendance[]
  sessions    GameSession[]
}

model Game {
  id          String   @id
  name        String
  description String
  thumbnail   String
  isActive    Boolean  @default(true)

  scores      Score[]
  sessions    GameSession[]
}

model Score {
  id                 String   @id @default(cuid())
  userId             String
  gameId             String
  characterId        String
  score              Int
  maxCombo           Int      @default(0)
  abilityActivations Int      @default(0)
  playedAt           DateTime @default(now())
  // 세션 토큰으로 만들어진 점수만 sessionId가 채워짐. 과거 데이터 호환을 위해 optional.
  sessionId          String?  @unique

  user               User         @relation(fields: [userId], references: [id])
  game               Game         @relation(fields: [gameId], references: [id])
  session            GameSession? @relation(fields: [sessionId], references: [id])

  @@index([gameId, score])
  @@index([userId, playedAt])
}

/// 한 판의 게임 플레이를 추적. 시작 시 발급된 HMAC 토큰과 매칭되어야 점수 등록 가능.
model GameSession {
  id          String    @id @default(cuid())
  userId      String
  gameId      String
  characterId String
  nonce       String    // HMAC 서명에 포함되는 random salt
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("active") // active | submitted | expired | rejected

  user        User      @relation(fields: [userId], references: [id])
  game        Game      @relation(fields: [gameId], references: [id])
  score       Score?

  @@index([userId, gameId, startedAt])
  @@index([status, startedAt])
}

model DailyChallenge {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD (KST)
  type      String   // 'play_games' | 'total_score' | 'max_combo'
  target    Int
  progress  Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date, type])
  @@index([userId, date])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD (KST)
  streak    Int      @default(1)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}
