# Supabase: Pooler (Transaction mode, port 6543) — for app runtime
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase: Direct connection (port 5432) — for prisma migrate
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me-in-production-please-use-32-chars-min"

# 공유 링크용 사이트 도메인 (예: https://samg-game.vercel.app)
# 미설정 시 window.location.origin 사용
NEXT_PUBLIC_SITE_URL="https://samg-game.vercel.app"
